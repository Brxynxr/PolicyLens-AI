FROM python:3.12-slim

# Evitar prompts interactivos y optimizar logs
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Instalar dependencias del sistema necesarias para PyMuPDF y PyTorch/OpenMP
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar dependencias de Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar el código del proyecto
COPY backend/ ./backend
COPY documents/ ./documents

# Crear directorio para persistencia de ChromaDB si no existe
RUN mkdir -p chroma_data

EXPOSE 8000

# Comando de inicio del backend
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
