# Etapa 1: Construcción del frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar manifiestos e instalar dependencias
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

# Copiar código fuente y compilar bundle de producción
COPY frontend/ .
RUN npm run build

# Etapa 2: Servidor Nginx de producción
FROM nginx:alpine

# Copiar bundle compilado al directorio de Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuración personalizada con soporte de proxy y streaming SSE
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
