# LLM (NVIDIA NIM o Local via Ollama):
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1

# Modelo de embeddings local (sentence-transformers).
# bge-m3: ~2.3 GB de descarga inicial, 1024 dimensiones.
# Si lo cambias, regenera el indice: python -m backend.scripts.reindexar_todo
EMBEDDING_MODEL_LOCAL=BAAI/bge-m3

DATABASE_URL=sqlite:///./sql_app.db
CORS_ORIGINS=http://localhost:5173

# Opcional: ruta del almacen vectorial de ChromaDB.
# Por defecto: <proyecto>/chroma_data. Los tests la fijan automaticamente
# a un directorio temporal para no tocar el indice productivo.
# CHROMA_PATH=./chroma_data
